{
  "schema_version": 1,
  "scenario_id": "deepseek-signup-gate",
  "bundle_id": "com.deepseek.chat",
  "fresh_launch": true,
  "steps": [
    {"action": "observe", "contains": ["Continue with Password", "Sign up"]},
    {"action": "screenshot", "stable": true, "ready_contains": "Sign up"},
    {"action": "tap_label", "label": "Sign up"},
    {"action": "observe", "wait_ms": 300,
     "contains": ["Terms of Use and Privacy Policy", "Cancel", "Agree"]},
    {"action": "screenshot", "stable": true,
     "ready_contains": "Terms of Use and Privacy Policy"}
  ]
}
